{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "proto-tool",
  "version": "0.2.0",
  "identifier": "io.github.kuner66.proto-tool",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "proto-tool —— 原型备注工具",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "DeveloperTool",
    "shortDescription": "给任意 HTML 原型贴便利贴，备注直接烧进文件",
    "longDescription": "proto-tool 把批注写进 HTML 文件本身：打开任意原型、像贴便利贴一样留备注、保存时把备注烧进文件。发给别人双击就能看到，不装工具、不联网、不用账号。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
