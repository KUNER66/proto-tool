{
  "name": "proto-tool",
  "version": "0.2.0",
  "description": "给任意 HTML 原型贴便利贴，备注直接烧进文件——发给别人双击就能看到，零依赖、零联网。",
  "keywords": [
    "annotation",
    "notes",
    "sticky-notes",
    "prototype",
    "html",
    "wireframe",
    "axure-alternative",
    "offline",
    "self-contained",
    "desktop",
    "tauri"
  ],
  "license": "MIT",
  "author": "KUNER66",
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/SKSKCODE/nami.git"
  },
  "homepage": "https://gitee.com/SKSKCODE/nami",
  "bugs": {
    "url": "https://gitee.com/SKSKCODE/nami/issues"
  },
  "main": "src/lib/injector.js",
  "bin": {
    "proto-tool": "server/index.js"
  },
  "files": [
    "src/",
    "server/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node server/index.js --open",
    "serve": "node server/index.js",
    "test": "node test/injector.test.js",
    "test:e2e": "node test/server.e2e.js",
    "test:browser": "node test/browser.smoke.mjs",
    "test:all": "node test/injector.test.js && node test/server.e2e.js && node test/browser.smoke.mjs",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "tauri": "tauri"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3"
  }
}
