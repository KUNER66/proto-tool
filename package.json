{
  "name": "proto-tool",
  "version": "0.1.0",
  "description": "给任意 HTML 原型贴便利贴，备注直接烧进文件——发给别人双击就能看到，零依赖、零联网。",
  "keywords": [
    "annotation",
    "notes",
    "sticky-notes",
    "prototype",
    "html",
    "wireframe",
    "axure-alternative",
    "offline",
    "self-contained"
  ],
  "license": "MIT",
  "author": "KUNER66",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KUNER66/proto-tool.git"
  },
  "homepage": "https://github.com/KUNER66/proto-tool#readme",
  "bugs": {
    "url": "https://github.com/KUNER66/proto-tool/issues"
  },
  "main": "lib/injector.js",
  "bin": {
    "proto-tool": "src/server.js"
  },
  "files": [
    "lib/",
    "src/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node src/server.js --open",
    "serve": "node src/server.js",
    "test": "node test/injector.test.js",
    "test:e2e": "node test/server.e2e.js",
    "test:browser": "node test/browser.smoke.mjs",
    "test:all": "node test/injector.test.js && node test/server.e2e.js && node test/browser.smoke.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "dependencies": {},
  "devDependencies": {}
}
